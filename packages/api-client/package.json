{
  "name": "@chs/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the CHS API, derived from @chs/contract: fetch with token refresh, realtime socket, and React Query hooks.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@chs/contract": "*",
    "@tanstack/react-query": "^5.90.0",
    "react": ">=18",
    "socket.io-client": "^4.8.0",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@tanstack/react-query": { "optional": true }
  },
  "devDependencies": {
    "@chs/contract": "*",
    "@tanstack/react-query": "^5.103.2",
    "@types/react": "^19.2.18",
    "react": "^19.2.3",
    "socket.io-client": "^4.8.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.1.0"
  }
}
