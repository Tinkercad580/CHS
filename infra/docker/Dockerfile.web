# syntax=docker/dockerfile:1.7
# Admin console — static build served by nginx, which also proxies the API and socket.

FROM node:20.19-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages packages
RUN npm ci --workspaces --include-workspace-root --ignore-scripts
COPY web-app/package.json web-app/package-lock.json web-app/
RUN cd web-app && npm ci
COPY web-app web-app
ARG VITE_API_ORIGIN=
ENV VITE_API_ORIGIN=$VITE_API_ORIGIN
RUN cd web-app && npm run build

FROM nginx:1.27-alpine
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web-app/dist /usr/share/nginx/html
EXPOSE 80
