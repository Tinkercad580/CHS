// ─── Billing (MASTER_SPEC C4, B2, B3) ────────────────────────────────────────

/// Charge categories follow Rule 106C-12(1); each allows only the
/// apportionment methods 106C-12(3) permits for it (see billing/domain/rules.ts).
enum ChargeCategory {
  SERVICE
  PROPERTY_TAX
  WATER
  LIFT
  PARKING
  NON_OCCUPANCY
  INSURANCE
  LEASE_RENT
  LOAN
  SINKING_FUND
  REPAIR_FUND
  MAJOR_REPAIR_FUND
  EDUCATION_FUND
  ELECTION_FUND
  WELFARE_FUND
  OTHER_FUND
  AMENITY
  COMMON_AREA
  COMMERCIAL_SURCHARGE
  GB_APPROVED_OTHER
  OTHER
}

enum ApportionmentMethod {
  EQUAL_PER_UNIT
  PER_CARPET_AREA
  PER_WATER_INLET
  BUILDING_SCOPED_EQUAL
  PER_PARKING_SLOT
  PERCENT_OF_HEAD
  PERCENT_OF_CONSTRUCTION_COST
  PER_MEMBER_FIXED_OR_MIN
  FIXED_PER_UNIT_TYPE
  MANUAL
}

model ChargeHead {
  id           String              @id @default(uuid(7)) @db.Uuid
  societyId    String              @map("society_id") @db.Uuid
  code         String              @db.VarChar(20)
  name         String              @db.VarChar(80)
  nameMr       String?             @map("name_mr") @db.VarChar(80)
  category     ChargeCategory
  method       ApportionmentMethod
  gstApplicable Boolean            @default(false) @map("gst_applicable")
  /// For PERCENT_OF_HEAD: the head whose amount this is a percentage of.
  baseHeadId   String?             @map("base_head_id") @db.Uuid
  /// Applicability: { unitTypes?, buildingIds?, occupancy?, floorMin?, floorMax? }
  filters      Json                @default("{}")
  resolution   Json?
  sortOrder    Int                 @default(100) @map("sort_order")
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  rates ChargeRate[]

  @@unique([societyId, code])
  @@map("charge_heads")
}

/// Effective-dated. Meaning of `rate` depends on the head's method (paise, paise per sq ft, basis points…).
model ChargeRate {
  id            String    @id @default(uuid(7)) @db.Uuid
  societyId     String    @map("society_id") @db.Uuid
  headId        String    @map("head_id") @db.Uuid
  rate          Decimal   @db.Decimal(18, 4)
  /// FIXED_PER_UNIT_TYPE: { "SHOP": 150000, … } in paise.
  rateByType    Json?     @map("rate_by_type")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  resolution    Json?
  note          String?   @db.VarChar(300)
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  head ChargeHead @relation(fields: [headId], references: [id])

  @@index([headId, effectiveFrom])
  @@map("charge_rates")
}

/// Per-unit amounts for MANUAL heads and recurring extras (a second parking slot, an AUTHORITY_FIXED property tax).
model UnitCharge {
  id            String    @id @default(uuid(7)) @db.Uuid
  societyId     String    @map("society_id") @db.Uuid
  unitId        String    @map("unit_id") @db.Uuid
  headId        String    @map("head_id") @db.Uuid
  amountPaise   BigInt    @map("amount_paise")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  note          String?   @db.VarChar(300)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([societyId, headId])
  @@index([unitId])
  @@map("unit_charges")
}

enum BillRunStatus {
  DRAFT
  PUBLISHED
  DISCARDED
}

model BillRun {
  id            String        @id @default(uuid(7)) @db.Uuid
  societyId     String        @map("society_id") @db.Uuid
  period        String        @db.VarChar(7)
  periodStart   DateTime      @map("period_start") @db.Date
  periodEnd     DateTime      @map("period_end") @db.Date
  billDate      DateTime      @map("bill_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  status        BillRunStatus @default(DRAFT)
  billCount     Int           @default(0) @map("bill_count")
  totalPaise    BigInt        @default(0) @map("total_paise")
  /// Config, rates and statutory values used — so a published run explains itself.
  snapshot      Json          @default("{}")
  exceptions    Json          @default("[]")
  createdById   String        @map("created_by") @db.Uuid
  publishedById String?       @map("published_by") @db.Uuid
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  bills Bill[]

  @@index([societyId, period])
  @@map("bill_runs")
}

enum BillStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BillKind {
  REGULAR
  SUPPLEMENTARY
}

/// Immutable once published: correction is cancel-and-reissue or a credit note.
model Bill {
  id                  String     @id @default(uuid(7)) @db.Uuid
  societyId           String     @map("society_id") @db.Uuid
  billRunId           String?    @map("bill_run_id") @db.Uuid
  unitId              String     @map("unit_id") @db.Uuid
  kind                BillKind   @default(REGULAR)
  status              BillStatus @default(DRAFT)
  number              String?    @db.VarChar(60)
  fy                  String     @db.VarChar(9)
  period              String     @db.VarChar(7)
  title               String     @db.VarChar(120)
  billDate            DateTime   @map("bill_date") @db.Date
  dueDate             DateTime   @map("due_date") @db.Date
  /// Charges excluding interest — what interest is later computed on.
  principalPaise      BigInt     @map("principal_paise")
  interestPaise       BigInt     @default(0) @map("interest_paise")
  gstPaise            BigInt     @default(0) @map("gst_paise")
  roundingPaise       BigInt     @default(0) @map("rounding_paise")
  totalPaise          BigInt     @map("total_paise")
  principalPaidPaise  BigInt     @default(0) @map("principal_paid_paise")
  interestPaidPaise   BigInt     @default(0) @map("interest_paid_paise")
  /// Balance brought forward when the bill was made, for display; not part of this bill's total.
  arrearsPaise        BigInt     @default(0) @map("arrears_paise")
  payerName           String?    @map("payer_name") @db.VarChar(100)
  /// Unit attributes as billed (area, inlets, occupancy, slots) — MASTER_SPEC C4 snapshot.
  attributes          Json       @default("{}")
  publishedAt         DateTime?  @map("published_at") @db.Timestamptz(3)
  cancelledAt         DateTime?  @map("cancelled_at") @db.Timestamptz(3)
  cancelReason        String?    @map("cancel_reason") @db.VarChar(300)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  billRun BillRun?   @relation(fields: [billRunId], references: [id])
  lines   BillLine[]

  @@index([societyId, unitId, status, dueDate])
  @@index([societyId, period])
  @@map("bills")
}

/// Each line carries how it was computed (method, rate, rate version, input, rule) — MASTER_SPEC B3.8.
model BillLine {
  id          String   @id @default(uuid(7)) @db.Uuid
  billId      String   @map("bill_id") @db.Uuid
  headId      String?  @map("head_id") @db.Uuid
  code        String   @db.VarChar(20)
  label       String   @db.VarChar(120)
  kind        String   @default("CHARGE") @db.VarChar(20)
  method      String?  @db.VarChar(40)
  rate        String?  @db.VarChar(40)
  rateId      String?  @map("rate_id") @db.Uuid
  input       String?  @db.VarChar(60)
  basis       String   @db.VarChar(200)
  ruleRef     String?  @map("rule_ref") @db.VarChar(100)
  amountPaise BigInt   @map("amount_paise")
  sortOrder   Int      @default(0) @map("sort_order")

  bill Bill @relation(fields: [billId], references: [id])

  @@index([billId])
  @@map("bill_lines")
}

enum LedgerKind {
  OPENING
  BILL
  PAYMENT
  CREDIT_NOTE
  REVERSAL
  ADVANCE_APPLIED
}

/// Append-only (trigger). Debit = owed by the unit, credit = paid or waived.
model LedgerEntry {
  id          String     @id @default(uuid(7)) @db.Uuid
  societyId   String     @map("society_id") @db.Uuid
  unitId      String     @map("unit_id") @db.Uuid
  date        DateTime   @db.Date
  kind        LedgerKind
  refType     String     @map("ref_type") @db.VarChar(30)
  refId       String     @map("ref_id") @db.Uuid
  debitPaise  BigInt     @default(0) @map("debit_paise")
  creditPaise BigInt     @default(0) @map("credit_paise")
  narration   String     @db.VarChar(200)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([societyId, unitId, date])
  @@map("ledger_entries")
}

model CreditNote {
  id          String   @id @default(uuid(7)) @db.Uuid
  societyId   String   @map("society_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  billId      String?  @map("bill_id") @db.Uuid
  number      String   @db.VarChar(60)
  amountPaise BigInt   @map("amount_paise")
  reason      String   @db.VarChar(300)
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([societyId, unitId])
  @@map("credit_notes")
}

// ─── Payments (MASTER_SPEC C5) ──────────────────────────────────────────────

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REVERSED
}

enum PaymentMode {
  ONLINE
  UPI
  CASH
  CHEQUE
  NEFT
  RTGS
  IMPS
  OTHER
}

model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  societyId        String        @map("society_id") @db.Uuid
  unitId           String        @map("unit_id") @db.Uuid
  amountPaise      BigInt        @map("amount_paise")
  mode             PaymentMode
  status           PaymentStatus @default(CREATED)
  gateway          String?       @db.VarChar(20)
  gatewayOrderId   String?       @unique @map("gateway_order_id") @db.VarChar(100)
  gatewayPaymentId String?       @unique @map("gateway_payment_id") @db.VarChar(100)
  instrumentNo     String?       @map("instrument_no") @db.VarChar(40)
  instrumentDate   DateTime?     @map("instrument_date") @db.Date
  bankName         String?       @map("bank_name") @db.VarChar(100)
  remarks          String?       @db.VarChar(300)
  failureReason    String?       @map("failure_reason") @db.VarChar(300)
  payerUserId      String?       @map("payer_user_id") @db.Uuid
  recordedById     String?       @map("recorded_by") @db.Uuid
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  receipt     Receipt?
  allocations Allocation[]

  @@index([societyId, unitId, createdAt(sort: Desc)])
  @@index([societyId, status])
  @@map("payments")
}

enum ReceiptStatus {
  ISSUED
  CANCELLED
}

model Receipt {
  id           String        @id @default(uuid(7)) @db.Uuid
  societyId    String        @map("society_id") @db.Uuid
  unitId       String        @map("unit_id") @db.Uuid
  paymentId    String        @unique @map("payment_id") @db.Uuid
  number       String        @db.VarChar(60)
  fy           String        @db.VarChar(9)
  amountPaise  BigInt        @map("amount_paise")
  date         DateTime      @db.Date
  status       ReceiptStatus @default(ISSUED)
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?       @map("cancel_reason") @db.VarChar(300)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([societyId, number])
  @@map("receipts")
}

enum AllocationBucket {
  INTEREST
  PRINCIPAL
  ADVANCE
}

/// Where a payment went. Negative amounts reverse an earlier allocation.
model Allocation {
  id          String           @id @default(uuid(7)) @db.Uuid
  societyId   String           @map("society_id") @db.Uuid
  paymentId   String           @map("payment_id") @db.Uuid
  unitId      String           @map("unit_id") @db.Uuid
  billId      String?          @map("bill_id") @db.Uuid
  bucket      AllocationBucket
  amountPaise BigInt           @map("amount_paise")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([societyId, unitId, bucket])
  @@index([billId])
  @@map("allocations")
}

/// Webhooks are idempotent by the gateway's event id — MASTER_SPEC C5.
model GatewayEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  gateway     String   @db.VarChar(20)
  eventId     String   @map("event_id") @db.VarChar(120)
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([gateway, eventId])
  @@map("gateway_events")
}
