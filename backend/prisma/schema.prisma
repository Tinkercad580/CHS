// CHS platform — Phases 1–3 (auth & access, society setup, members & occupancy).
//
// Conventions (MASTER_SPEC E2): UUID v7 keys; society_id on every business
// table with composite indexes; money as BIGINT paise; timestamptz in UTC;
// created_at / updated_at on every table; soft delete (deleted_at) where
// history must survive; effective dating on occupancies, memberships,
// tenancies and statutory_config.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & access ──────────────────────────────────────────────────────

/// A person who can sign in. One mobile = one account, across societies.
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  mobile             String    @unique @db.VarChar(10)
  name               String    @db.VarChar(100)
  email              String?   @db.VarChar(254)
  language           String    @default("en") @db.VarChar(5)
  passwordHash       String?   @map("password_hash")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(3)
  termsAcceptedAt    DateTime? @map("terms_accepted_at") @db.Timestamptz(3)
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  totpSecret         String?   @map("totp_secret")
  totpPendingSecret  String?   @map("totp_pending_secret")
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  isPlatformAdmin    Boolean   @default(false) @map("is_platform_admin")
  /// Bumped to invalidate every outstanding access token at once.
  tokenVersion       Int       @default(0) @map("token_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  societyUsers    SocietyUser[]
  sessions        Session[]
  passwordHistory PasswordHistory[]
  tempPasswords   TempPassword[]
  authEvents      AuthEvent[]      @relation("AuthEventUser")
  persons         Person[]

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

enum UserType {
  OWNER
  CO_OWNER
  FAMILY
  TENANT
  GUARD
  STAFF
  ACCOUNTANT
  AUDITOR
  COMMITTEE
  MANAGER
}

/// A user's access to one society: role, label and granted permissions.
model SocietyUser {
  id              String    @id @default(uuid(7)) @db.Uuid
  societyId       String    @map("society_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  role            Role      @default(USER)
  userType        UserType  @map("user_type")
  permissions     String[]
  unitId          String?   @map("unit_id") @db.Uuid
  notes           String?   @db.VarChar(500)
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspendedReason String?   @map("suspended_reason") @db.VarChar(300)
  createdById     String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  society Society @relation(fields: [societyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  unit    Unit?   @relation(fields: [unitId], references: [id])

  @@unique([societyId, userId])
  @@index([societyId, role])
  @@index([societyId, unitId])
  @@map("society_users")
}

model PermissionTemplate {
  id          String   @id @default(uuid(7)) @db.Uuid
  societyId   String   @map("society_id") @db.Uuid
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(60)
  role        Role
  userType    UserType @map("user_type")
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  society Society @relation(fields: [societyId], references: [id])

  @@unique([societyId, code])
  @@map("permission_templates")
}

/// A signed-in device. The refresh token is stored only as a hash and
/// rotates on every use; presenting a rotated-out token revokes the family.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  previousHash     String?   @map("previous_hash")
  client           String    @db.VarChar(20)
  deviceId         String?   @map("device_id") @db.VarChar(100)
  deviceName       String?   @map("device_name") @db.VarChar(100)
  ip               String?   @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(300)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(60)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([previousHash])
  @@map("sessions")
}

model PasswordHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

/// Single use, 24 h. Stored hashed; the plain value is shown to the issuing
/// admin once and sent to the user once.
model TempPassword {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  passwordHash String    @map("password_hash")
  issuedById   String    @map("issued_by") @db.Uuid
  societyId    String    @map("society_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
  @@map("temp_passwords")
}

model LoginAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  mobile    String   @db.VarChar(10)
  ip        String?  @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ip, createdAt])
  @@index([mobile, createdAt])
  @@map("login_attempts")
}

enum AuthEventType {
  ACTIVATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOCKED
  UNLOCKED
  PASSWORD_CHANGED
  TEMP_PASSWORD_ISSUED
  SESSION_REVOKED
  ALL_SESSIONS_REVOKED
  REFRESH_REUSE_DETECTED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  SUSPENDED
  REACTIVATED
}

model AuthEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  societyId String?       @map("society_id") @db.Uuid
  actorId   String?       @map("actor_id") @db.Uuid
  type      AuthEventType
  ip        String?       @db.VarChar(64)
  userAgent String?       @map("user_agent") @db.VarChar(300)
  detail    String?       @db.VarChar(300)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation("AuthEventUser", fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("auth_events")
}

/// Every create, update, delete and approval — before/after JSON, 8-year retention.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  societyId  String?  @map("society_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name") @db.VarChar(100)
  action     String   @db.VarChar(60)
  entity     String   @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(60)
  permission String?  @db.VarChar(40)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(300)
  requestId  String?  @map("request_id") @db.VarChar(64)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([societyId, createdAt(sort: Desc)])
  @@index([societyId, entity, entityId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @db.VarChar(100)
  userId      String   @map("user_id") @db.Uuid
  endpointId  String   @map("endpoint_id") @db.VarChar(80)
  requestHash String   @map("request_hash") @db.VarChar(64)
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Messages handed to SMS / WhatsApp / email providers. In development the
/// provider is a log adapter and this table is the inbox.
model OutboundMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  societyId   String?   @map("society_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  channel     String    @db.VarChar(20)
  to          String    @db.VarChar(254)
  template    String    @db.VarChar(60)
  body        String
  status      String    @default("QUEUED") @db.VarChar(20)
  providerRef String?   @map("provider_ref") @db.VarChar(100)
  error       String?   @db.VarChar(500)
  attempts    Int       @default(0)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("outbound_messages")
}

// ─── Society & structure ────────────────────────────────────────────────────

enum SocietyType {
  SOCIETY_CHS
  SOCIETY_AOA
  UNREGISTERED
}

enum SocietyStatus {
  DRAFT
  LIVE
  SUSPENDED
}

model Society {
  id                 String        @id @default(uuid(7)) @db.Uuid
  code               String        @unique @db.VarChar(12)
  name               String        @db.VarChar(150)
  type               SocietyType
  status             SocietyStatus @default(DRAFT)
  registrationNumber String?       @map("registration_number") @db.VarChar(60)
  registrationDate   DateTime?     @map("registration_date") @db.Date
  addressLine        String?       @map("address_line") @db.VarChar(300)
  city               String?       @db.VarChar(80)
  district           String?       @db.VarChar(80)
  pincode            String?       @db.VarChar(6)
  registrarOffice    String?       @map("registrar_office") @db.VarChar(150)
  pan                String?       @db.VarChar(10)
  tan                String?       @db.VarChar(10)
  gstin              String?       @db.VarChar(15)
  gstRegistered      Boolean       @default(false) @map("gst_registered")
  fyStartMonth       Int           @default(4) @map("fy_start_month")
  contactEmail       String?       @map("contact_email") @db.VarChar(254)
  contactPhone       String?       @map("contact_phone") @db.VarChar(20)
  settings           Json          @default("{}")
  wentLiveAt         DateTime?     @map("went_live_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  societyUsers        SocietyUser[]
  permissionTemplates PermissionTemplate[]
  buildings           Building[]
  units               Unit[]
  parkingSlots        ParkingSlot[]
  bankAccounts        BankAccount[]
  billingConfig       BillingConfig?
  numberingSeries     NumberingSeries[]
  persons             Person[]

  @@map("societies")
}

model Building {
  id                    String    @id @default(uuid(7)) @db.Uuid
  societyId             String    @map("society_id") @db.Uuid
  name                  String    @db.VarChar(60)
  wing                  String?   @db.VarChar(20)
  floorCount            Int       @map("floor_count")
  liftPresent           Boolean   @map("lift_present")
  constructionYear      Int?      @map("construction_year")
  constructionCostPaise BigInt?   @map("construction_cost_paise")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  society      Society       @relation(fields: [societyId], references: [id])
  units        Unit[]
  parkingSlots ParkingSlot[]

  @@unique([societyId, name])
  @@map("buildings")
}

enum UnitType {
  RESIDENTIAL
  COMMERCIAL
  SHOP
  OFFICE
  PARKING_ONLY
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

model Unit {
  id                 String     @id @default(uuid(7)) @db.Uuid
  societyId          String     @map("society_id") @db.Uuid
  buildingId         String     @map("building_id") @db.Uuid
  number             String     @db.VarChar(20)
  floor              Int
  type               UnitType   @default(RESIDENTIAL)
  status             UnitStatus @default(ACTIVE)
  carpetAreaSqft     Decimal?   @map("carpet_area_sqft") @db.Decimal(10, 2)
  builtUpAreaSqft    Decimal?   @map("built_up_area_sqft") @db.Decimal(10, 2)
  waterInlets        Int        @default(1) @map("water_inlets")
  liftServed         Boolean    @map("lift_served")
  shareCertificateNo String?    @map("share_certificate_no") @db.VarChar(40)
  /// Set once the unit appears on a published bill; it can then only be deactivated, never removed.
  firstBilledAt      DateTime?  @map("first_billed_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  society      Society        @relation(fields: [societyId], references: [id])
  building     Building       @relation(fields: [buildingId], references: [id])
  societyUsers SocietyUser[]
  parkingSlots ParkingSlot[]
  memberships  Membership[]
  occupancies  Occupancy[]
  tenancies    Tenancy[]
  family       FamilyMember[]
  vehicles     Vehicle[]
  pets         Pet[]
  approvals    MemberApproval[]

  @@unique([buildingId, number])
  @@index([societyId, buildingId])
  @@map("units")
}

enum ParkingType {
  CAR_COVERED
  CAR_OPEN
  CAR_STILT
  TWO_WHEELER
  VISITOR
}

model ParkingSlot {
  id         String      @id @default(uuid(7)) @db.Uuid
  societyId  String      @map("society_id") @db.Uuid
  buildingId String?     @map("building_id") @db.Uuid
  code       String      @db.VarChar(20)
  type       ParkingType
  unitId     String?     @map("unit_id") @db.Uuid
  allottedAt DateTime?   @map("allotted_at") @db.Timestamptz(3)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  society  Society   @relation(fields: [societyId], references: [id])
  building Building? @relation(fields: [buildingId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])
  vehicles Vehicle[]

  @@unique([societyId, code])
  @@map("parking_slots")
}

enum BankPurpose {
  OPERATIONS
  SINKING
  REPAIR
  OTHER
}

enum BankAccountType {
  SAVINGS
  CURRENT
}

model BankAccount {
  id                  String          @id @default(uuid(7)) @db.Uuid
  societyId           String          @map("society_id") @db.Uuid
  bankName            String          @map("bank_name") @db.VarChar(100)
  accountName         String          @map("account_name") @db.VarChar(150)
  accountNumber       String          @map("account_number") @db.VarChar(20)
  ifsc                String          @db.VarChar(11)
  type                BankAccountType
  purpose             BankPurpose
  openingBalancePaise BigInt          @default(0) @map("opening_balance_paise")
  openingBalanceDate  DateTime?       @map("opening_balance_date") @db.Date
  vanPrefix           String?         @map("van_prefix") @db.VarChar(20)
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  society Society @relation(fields: [societyId], references: [id])

  @@unique([societyId, accountNumber, ifsc])
  @@map("bank_accounts")
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
}

model BillingConfig {
  id                   String       @id @default(uuid(7)) @db.Uuid
  societyId            String       @unique @map("society_id") @db.Uuid
  cycle                BillingCycle @default(MONTHLY)
  generationDay        Int          @default(1) @map("generation_day")
  dueDay               Int          @default(15) @map("due_day")
  graceDays            Int          @default(0) @map("grace_days")
  interestRateBps      Int          @default(0) @map("interest_rate_bps")
  interestResolution   Json?        @map("interest_resolution")
  roundingRule         String       @default("NEAREST_RUPEE") @map("rounding_rule") @db.VarChar(20)
  billNumberFormat     String       @default("{CODE}/{FY}/{SEQ}") @map("bill_number_format") @db.VarChar(60)
  receiptNumberFormat  String       @default("{CODE}/R/{FY}/{SEQ}") @map("receipt_number_format") @db.VarChar(60)
  allowPartialPayment  Boolean      @default(true) @map("allow_partial_payment")
  allocationOrder      String[]     @default(["INTEREST", "ARREARS", "CURRENT"]) @map("allocation_order")
  effectiveFromPeriod  String?      @map("effective_from_period") @db.VarChar(7)
  configuredAt         DateTime?    @map("configured_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  society Society @relation(fields: [societyId], references: [id])

  @@map("billing_configs")
}

/// Gapless per-FY sequences (bills, receipts, NOCs). Incremented with a row lock.
model NumberingSeries {
  id        String   @id @default(uuid(7)) @db.Uuid
  societyId String   @map("society_id") @db.Uuid
  series    String   @db.VarChar(30)
  fy        String   @db.VarChar(9)
  nextValue Int      @default(1) @map("next_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  society Society @relation(fields: [societyId], references: [id])

  @@unique([societyId, series, fy])
  @@map("numbering_series")
}

/// Effective-dated statutory parameters (MASTER_SPEC B4). society_id null =
/// platform default; a society row overrides it from its effective date.
/// Billing resolves as of the billing period, never "now".
model StatutoryConfig {
  id                  String    @id @default(uuid(7)) @db.Uuid
  societyId           String?   @map("society_id") @db.Uuid
  key                 String    @db.VarChar(60)
  value               String    @db.VarChar(200)
  unit                String?   @db.VarChar(30)
  effectiveFrom       DateTime  @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date
  sourceReference     String?   @map("source_reference") @db.VarChar(500)
  ruleCitation        String?   @map("rule_citation") @db.VarChar(200)
  verifiedOn          DateTime? @map("verified_on") @db.Date
  resolutionReference Json?     @map("resolution_reference")
  setById             String?   @map("set_by") @db.Uuid
  note                String?   @db.VarChar(300)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([key, societyId, effectiveFrom])
  @@map("statutory_config")
}

model ImportJob {
  id        String   @id @default(uuid(7)) @db.Uuid
  societyId String   @map("society_id") @db.Uuid
  kind      String   @db.VarChar(20)
  dryRun    Boolean  @map("dry_run")
  total     Int
  created   Int
  errors    Json
  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([societyId, createdAt])
  @@map("import_jobs")
}

// ─── Members & occupancy ────────────────────────────────────────────────────

/// Someone the society records — owner, tenant, nominee — whether or not
/// they have an app login. `userId` links them when they do.
model Person {
  id        String    @id @default(uuid(7)) @db.Uuid
  societyId String    @map("society_id") @db.Uuid
  name      String    @db.VarChar(100)
  mobile    String?   @db.VarChar(10)
  email     String?   @db.VarChar(254)
  userId    String?   @map("user_id") @db.Uuid
  directoryListed    Boolean @default(true) @map("directory_listed")
  directoryShowMobile Boolean @default(false) @map("directory_show_mobile")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  society     Society      @relation(fields: [societyId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  memberships Membership[]
  tenancies   Tenancy[]

  @@index([societyId, mobile])
  @@index([societyId, userId])
  @@map("persons")
}

enum MembershipKind {
  PRIMARY
  CO_OWNER
  ASSOCIATE
}

model Membership {
  id                 String         @id @default(uuid(7)) @db.Uuid
  societyId          String         @map("society_id") @db.Uuid
  unitId             String         @map("unit_id") @db.Uuid
  personId           String         @map("person_id") @db.Uuid
  kind               MembershipKind
  shareCertificateNo String?        @map("share_certificate_no") @db.VarChar(40)
  sharesHeld         Int?           @map("shares_held")
  admissionDate      DateTime       @map("admission_date") @db.Date
  cessationDate      DateTime?      @map("cessation_date") @db.Date
  cessationReason    String?        @map("cessation_reason") @db.VarChar(300)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit     Unit      @relation(fields: [unitId], references: [id])
  person   Person    @relation(fields: [personId], references: [id])
  nominees Nominee[]

  @@index([societyId, unitId, cessationDate])
  @@map("memberships")
}

enum OccupancyStatus {
  SELF_OCCUPIED
  FAMILY_OCCUPIED
  TENANTED
  VACANT
  LOCKED
  UNDER_RENOVATION
}

/// Effective-dated. The row with effective_to null is current. Non-occupancy
/// charges apply only while status = TENANTED (MASTER_SPEC B3.2).
model Occupancy {
  id            String          @id @default(uuid(7)) @db.Uuid
  societyId     String          @map("society_id") @db.Uuid
  unitId        String          @map("unit_id") @db.Uuid
  status        OccupancyStatus
  effectiveFrom DateTime        @map("effective_from") @db.Date
  effectiveTo   DateTime?       @map("effective_to") @db.Date
  note          String?         @db.VarChar(300)
  createdById   String?         @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([societyId, unitId, effectiveFrom])
  @@map("occupancies")
}

enum BillPayer {
  OWNER
  TENANT
}

model Tenancy {
  id                  String    @id @default(uuid(7)) @db.Uuid
  societyId           String    @map("society_id") @db.Uuid
  unitId              String    @map("unit_id") @db.Uuid
  tenantPersonId      String    @map("tenant_person_id") @db.Uuid
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime  @map("end_date") @db.Date
  endedOn             DateTime? @map("ended_on") @db.Date
  monthlyRentPaise    BigInt?   @map("monthly_rent_paise")
  depositPaise        BigInt?   @map("deposit_paise")
  policeIntimationRef String?   @map("police_intimation_ref") @db.VarChar(60)
  allowedOccupants    Int?      @map("allowed_occupants")
  billPayer           BillPayer @default(OWNER) @map("bill_payer")
  expiryReminderSent  Boolean   @default(false) @map("expiry_reminder_sent")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit   Unit   @relation(fields: [unitId], references: [id])
  tenant Person @relation(fields: [tenantPersonId], references: [id])

  @@index([societyId, unitId, endedOn])
  @@index([endDate, endedOn])
  @@map("tenancies")
}

model FamilyMember {
  id          String    @id @default(uuid(7)) @db.Uuid
  societyId   String    @map("society_id") @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  name        String    @db.VarChar(100)
  relation    String    @db.VarChar(40)
  mobile      String?   @db.VarChar(10)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([societyId, unitId])
  @@map("family_members")
}

enum VehicleType {
  CAR
  TWO_WHEELER
  OTHER
}

model Vehicle {
  id            String      @id @default(uuid(7)) @db.Uuid
  societyId     String      @map("society_id") @db.Uuid
  unitId        String      @map("unit_id") @db.Uuid
  plate         String      @db.VarChar(15)
  type          VehicleType
  make          String?     @db.VarChar(60)
  colour        String?     @db.VarChar(30)
  ownerName     String?     @map("owner_name") @db.VarChar(100)
  parkingSlotId String?     @map("parking_slot_id") @db.Uuid
  stickerNo     String?     @map("sticker_no") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)

  unit        Unit         @relation(fields: [unitId], references: [id])
  parkingSlot ParkingSlot? @relation(fields: [parkingSlotId], references: [id])

  @@index([societyId, plate])
  @@index([societyId, unitId])
  @@map("vehicles")
}

model Pet {
  id              String    @id @default(uuid(7)) @db.Uuid
  societyId       String    @map("society_id") @db.Uuid
  unitId          String    @map("unit_id") @db.Uuid
  name            String    @db.VarChar(60)
  species         String    @db.VarChar(30)
  breed           String?   @db.VarChar(60)
  vaccinatedUntil DateTime? @map("vaccinated_until") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([societyId, unitId])
  @@map("pets")
}

model Nominee {
  id           String   @id @default(uuid(7)) @db.Uuid
  societyId    String   @map("society_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  name         String   @db.VarChar(100)
  relation     String   @db.VarChar(40)
  shareBps     Int      @map("share_bps")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([societyId, membershipId])
  @@map("nominees")
}

enum ApprovalKind {
  FAMILY_ADD
  VEHICLE_ADD
  PET_ADD
  TENANT_ADD
  PROFILE_CHANGE
  DATA_CORRECTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model MemberApproval {
  id            String         @id @default(uuid(7)) @db.Uuid
  societyId     String         @map("society_id") @db.Uuid
  unitId        String?        @map("unit_id") @db.Uuid
  kind          ApprovalKind
  status        ApprovalStatus @default(PENDING)
  payload       Json
  summary       String         @db.VarChar(200)
  requestedById String         @map("requested_by") @db.Uuid
  decidedById   String?        @map("decided_by") @db.Uuid
  decisionNote  String?        @map("decision_note") @db.VarChar(300)
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit Unit? @relation(fields: [unitId], references: [id])

  @@index([societyId, status, createdAt])
  @@map("member_approvals")
}
