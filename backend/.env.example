# Copy to .env and adjust. Every variable is validated at start-up (src/config/env.ts).
NODE_ENV=development
PORT=4100
# Public origin(s) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5273,http://localhost:8181,http://localhost:8182
DATABASE_URL=postgresql://chs:CHANGE_ME@127.0.0.1:5432/chs?schema=public
# Optional. Without it jobs run in-process and realtime stays on one node.
REDIS_URL=
# 32+ random bytes each: `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_RESTRICTED_SECRET=
# Encrypts TOTP secrets at rest.
DATA_ENCRYPTION_KEY=
LOG_LEVEL=info
# log | none — real SMS/WhatsApp/email adapters plug in here.
MESSAGING_PROVIDER=log
# Failed sign-ins per IP per hour before throttling (MASTER_SPEC A2.2 default 10)
LOGIN_IP_FAILURES_PER_HOUR=10
